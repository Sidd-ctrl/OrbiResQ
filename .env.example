# ORBI RESQ configuration. Copy to .env for local runs; never commit real credentials.
# Every value is optional. Keys and tokens are read from the process environment,
# so on AppJet set them in Settings -> Environment variables and redeploy.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/orbi_resq.db
DATA_DIR=./data

CV_SERVICE_URL=http://127.0.0.1:8100

ENABLE_OSM_DISCOVERY=true
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
ENABLE_CALTRANS_DISCOVERY=true
CALTRANS_DISTRICT=03
WINDY_API_KEY=
CAMERA_DIRECTORY_URL=

DEFAULT_RADIUS_KM=25
MAX_RADIUS_KM=100
MAX_DISCOVERY_RESULTS=250

STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

PUSH_PROVIDER_KEY=

SEED_DEMO_DATA=true
MAX_UPLOAD_MB=50
